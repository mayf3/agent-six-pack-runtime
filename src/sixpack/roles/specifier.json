{
  "role": "specifier",
  "owns": [
    "behavior_specification",
    "qa_procedure"
  ],
  "does_not_own": [
    "implementation_and_unit_tests",
    "acceptance_generator_runtime_step_handlers",
    "cleanup_and_local_quality_checks",
    "architecture_and_property_tests",
    "mutation_hardening",
    "executable_qa_automation",
    "final_qa_receipt"
  ],
  "required_inputs": [
    "accepted product authority at exact revision",
    "task mandate",
    "done_when"
  ],
  "permitted_mutations": [
    "behavior specification documents",
    "human-readable end-to-end QA procedure"
  ],
  "required_checks": [
    "behavior expressed in deterministic form",
    "no undocumented product contract invented"
  ],
  "handoff_target": "coder",
  "failure_output": "SPEC_GAP_DEPENDENCY=LOAD_BEARING, NEXT_ACTION=RE_PREFLIGHT",
  "done_criteria": [
    "externally observable behavior specified",
    "failure cases enumerated",
    "acceptance criteria recorded"
  ],
  "receive_mode": "task",
  "propagation": "forward-only",
  "terminal_broadcast": false
}
